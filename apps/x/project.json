{
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"name": "Software-Engineering-1-x",
	"sourceRoot": "src",
	"targets": {
		"build": {
			"executor": "nx:run-commands",
			"options": {
				"cwd": "{projectRoot}",
				"command": "mvn clean package"
			},
			"outputs": [
				"{projectRoot}/target"
			]
		},
		"test": {
			"executor": "nx:run-commands",
			"options": {
				"cwd": "{projectRoot}",
				"command": "mvn test"
			}
		},
		"clean": {
			"executor": "nx:run-commands",
			"options": {
				"cwd": "{projectRoot}",
				"command": "mvn clean"
			}
		}
	}
}
